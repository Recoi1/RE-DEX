{
	# Let's Encrypt only, no ZeroSSL fallback: the hosts' CAA records may allow letsencrypt.org alone
	cert_issuer acme https://acme-v02.api.letsencrypt.org/directory
}

(status_files) {
	root * /srv/status
	header Cache-Control "no-cache, no-store, must-revalidate"
	file_server
}

# One site for all three names, so ACCOUNTS_HOST, WORLD_HOST and STATUS_HOST may be one host name (routed by path) or
# three (routed by host). Caddy gets one certificate per distinct name; the world reads WORLD_HOST's from Caddy's data
# volume (certsync) for TLS on port 7777.
{$ACCOUNTS_HOST}, {$WORLD_HOST}, {$STATUS_HOST} {
	# passwords are typed on the account host's pages: HTTPS only, remembered for a year
	@accounts host {$ACCOUNTS_HOST}
	header @accounts Strict-Transport-Security "max-age=31536000"

	# The public status page (/status/) and progress card (/progress.svg): static files from deploy/status/render.py,
	# on paths no backend route uses. Never cached, so the card in the README shows the current state.
	@status {
		host {$STATUS_HOST}
		path /status /status/* /progress.svg
	}
	handle @status {
		redir /status /status/ 308
		uri strip_prefix /status
		import status_files
	}

	# the bare name opens the status page (the account API has no page at /)
	@root {
		host {$STATUS_HOST}
		path /
	}
	redir @root /status/ 302

	# The account API. The world-ticket check is for the world servers only, on the internal network: never here.
	handle @accounts {
		handle /internal/* {
			respond 404
		}
		reverse_proxy backend:8080
	}

	# a status host of its own also has the page at /
	@status_site {
		host {$STATUS_HOST}
		not host {$ACCOUNTS_HOST}
	}
	handle @status_site {
		import status_files
	}

	# a world host of its own: a notice
	handle {
		respond "RE:DEX world: join it from the game (tls:{$WORLD_HOST}:7777)" 200
	}
}
