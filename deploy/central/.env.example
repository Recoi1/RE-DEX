# DNS names pointing at this machine (Caddy gets a certificate for each)
ACCOUNTS_HOST=accounts.example.org
WORLD_HOST=world.example.org
STATUS_HOST=status.example.org
# folder with the rendered status page (deploy/status/render.py OUT_DIR); default ../status/site
#STATUS_SITE=/opt/redex/status/site
REDEX_MAIL_FROM=RE:DEX <no-reply@example.org>
# no SMTP account yet: write mails to a folder in the backend's volume instead (see docker-compose.maildir.yml)
#COMPOSE_FILE=docker-compose.yml:docker-compose.maildir.yml
