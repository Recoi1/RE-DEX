# DNS names pointing at this machine (Caddy gets a Let's Encrypt certificate for each distinct one). One name for all
# three works: the account API at https://HOST/, the status page at https://HOST/status/ and the card at
# https://HOST/progress.svg, the world at tls:HOST:7777 (same certificate). Three names work too (the status page is
# then also at the status host's /). CAA records on the names, if any, must allow letsencrypt.org (Caddy uses no
# other CA).
ACCOUNTS_HOST=play.example.org
WORLD_HOST=play.example.org
STATUS_HOST=play.example.org
# folder with the rendered status page (deploy/status/render.py OUT_DIR); default ../status/site
#STATUS_SITE=/opt/redex/status/site
REDEX_MAIL_FROM=RE:DEX <no-reply@example.org>
# no SMTP account yet: write mails to a folder in the backend's volume instead (see docker-compose.maildir.yml)
#COMPOSE_FILE=docker-compose.yml:docker-compose.maildir.yml
